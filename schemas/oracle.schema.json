{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rfl-qa.dev/schemas/oracle.schema.json",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "oracle"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "competency_id": {
      "type": "string",
      "enum": [
        "C047",
        "C053",
        "C034"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "hard_gate_coverage": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "callback_after_free",
          "double_free",
          "uaf",
          "data_race",
          "deadlock",
          "prohibited_sleep",
          "ffi_lifetime",
          "critical_external_assumption",
          "required_abi_break",
          "dma_ownership"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "string",
            "minLength": 1
          },
          "expected_condition": {
            "type": "string",
            "minLength": 1
          },
          "failure_condition": {
            "type": "string",
            "minLength": 1
          },
          "predicate": {
            "type": "string",
            "enum": [
              "classification",
              "strength",
              "safety",
              "teardown"
            ]
          },
          "invariant_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "strengths": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "PROOF",
                "OBSERVATION",
                "COVERAGE",
                "ABSENCE_OF_EVIDENCE"
              ]
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "hard_gate_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "callback_after_free",
                "double_free",
                "uaf",
                "data_race",
                "deadlock",
                "prohibited_sleep",
                "ffi_lifetime",
                "critical_external_assumption",
                "required_abi_break",
                "dma_ownership"
              ]
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "input",
          "expected_condition",
          "failure_condition",
          "predicate",
          "invariant_refs",
          "strengths",
          "hard_gate_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "teardown_model": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "safety_predicates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "record_type",
    "id",
    "competency_id",
    "description",
    "hard_gate_coverage",
    "checks",
    "teardown_model",
    "safety_predicates"
  ],
  "additionalProperties": false,
  "$defs": {
    "task": {
      "type": "object",
      "properties": {
        "record_type": {
          "const": "task"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "competency_id": {
          "type": "string",
          "enum": [
            "C047",
            "C053",
            "C034"
          ]
        },
        "oracle_ref": {
          "type": "string",
          "minLength": 1
        },
        "candidate_task": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "required_outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "measurement": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "record_type",
        "id",
        "competency_id",
        "oracle_ref",
        "candidate_task",
        "inputs",
        "required_outputs",
        "measurement"
      ],
      "additionalProperties": false
    },
    "expected_observations": {
      "type": "object",
      "properties": {
        "record_type": {
          "const": "expected_observations"
        },
        "oracle_ref": {
          "type": "string",
          "minLength": 1
        },
        "expectations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "check_id": {
                "type": "string",
                "minLength": 1
              },
              "expected_result": {
                "type": "string",
                "enum": [
                  "PASS",
                  "BLOCKED"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "check_id",
              "expected_result",
              "reason"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "record_type",
        "oracle_ref",
        "expectations"
      ],
      "additionalProperties": false
    }
  }
}
